{
  "name": "english-reading-ai",
  "productName": "English Reading AI",
  "description": "English Reading AI - Đọc và học tiếng Anh theo phương pháp cụm từ (Lexical Chunks)",
  "author": "English Reading AI Team <contact@englishreadingai.local>",
  "homepage": "https://github.com/english-reading-ai",
  "desktopName": "english-reading-ai.desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron . --no-sandbox",
    "app:dev": "vite & electron . --no-sandbox",
    "app:build": "npm run build && electron-builder --linux",
    "app:build:dir": "npm run build && electron-builder --linux --dir",
    "app:build:appimage": "npm run build && electron-builder --linux AppImage",
    "app:build:deb": "npm run build && electron-builder --linux deb",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
